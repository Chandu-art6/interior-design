# Application Settings
APP_NAME="AI Interior Space Redesign & Comfort Optimizer"
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
DEBUG=True

# Compute Configuration (cuda, cpu, auto)
DEVICE=auto
TORCH_DTYPE=float16

# AI Model Checkpoints
YOLO_MODEL_NAME=yolov8m.pt
STABLE_DIFFUSION_MODEL_ID=runwayml/stable-diffusion-v1-5
CONTROLNET_CANNY_MODEL_ID=lllyasviel/control_v11p_sd15_canny
CONTROLNET_MLSD_MODEL_ID=lllyasviel/control_v11p_sd15_mlsd
CONTROLNET_DEPTH_MODEL_ID=lllyasviel/control_v11f1p_sd15_depth

# Database URL
DATABASE_URL=sqlite:///./database/interior_design.db

# Optional LLM API Keys (for enhanced interior design reasoning)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
OPENAI_API_KEY=
